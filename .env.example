# Copiá este archivo a .env y completá los valores. El archivo .env nunca se sube al repo.

# --- Discord (obligatorio) ---
# Token del bot: Discord Developer Portal > tu aplicación > Bot > Reset Token
DISCORD_TOKEN=
# ID del servidor privado donde vive Prisma (Modo desarrollador > clic derecho en el servidor > Copiar ID)
DISCORD_GUILD_ID=

# --- General (opcional) ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
