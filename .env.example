# Copiá este archivo a .env y completá los valores. El archivo .env nunca se sube al repo.

# --- Discord (obligatorio) ---
# Token del bot: Discord Developer Portal > tu aplicación > Bot > Reset Token
DISCORD_TOKEN=
# ID del servidor privado donde vive Prisma (Modo desarrollador > clic derecho en el servidor > Copiar ID)
DISCORD_GUILD_ID=

# --- Música (Lavalink) ---
# Clave interna entre el bot y Lavalink (mínimo 16 caracteres). Generala con: openssl rand -hex 24
LAVALINK_PASSWORD=
# Volumen inicial de la música (1-150)
MUSIC_DEFAULT_VOLUME=80

# Spotify (opcional): permite pegar enlaces de temas y álbumes; el audio se busca en SoundCloud.
# Requiere una app en https://developer.spotify.com/dashboard cuyo dueño tenga Spotify Premium.
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# País del catálogo de Spotify (código de 2 letras)
SPOTIFY_MARKET=AR

# --- Voz e IA (opcional: sin esto, Prisma funciona solo con música) ---
# Token del segundo bot "Prisma Voz" (otra aplicación en el Developer Portal)
VOICE_DISCORD_TOKEN=
# API key gratuita de https://console.groq.com/keys
GROQ_API_KEY=
# Modelos de Groq (ver https://console.groq.com/docs/models)
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Palabra para llamar a Prisma y minutos sin uso antes de que salga del canal
VOICE_WAKE_WORD=prisma
VOICE_IDLE_MINUTES=10
# Voz de Piper (requiere reconstruir la imagen tts) y velocidad (< 1 más rápido)
PIPER_VOICE=es_AR-daniela-high
PIPER_LENGTH_SCALE=0.95

# --- General (opcional) ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
